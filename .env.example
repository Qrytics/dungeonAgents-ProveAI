# ──────────────────────────────────────────────────────────────────────────────
# dungeonAgents-ProveAI — Environment Variables
#
# Copy this file to .env and fill in your actual keys.
#   cp .env.example .env
#
# On Windows PowerShell you can set variables inline instead:
#   $env:GOOGLE_API_KEY = "your_key_here"
#   $env:AGENT_LLM_MODEL = "gemini-2.0-flash"
# ──────────────────────────────────────────────────────────────────────────────

# ── Langfuse (observability) ──────────────────────────────────────────────────
# Get these from https://cloud.langfuse.com → Settings → API Keys
LANGFUSE_PUBLIC_KEY=your_key_here
LANGFUSE_SECRET_KEY=your_secret_here
LANGFUSE_HOST=https://cloud.langfuse.com

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Required only when AGENT_LLM_MODEL is an OpenAI model (e.g. gpt-4o-mini).
# Get your key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_key_here

# ── Google Gemini ─────────────────────────────────────────────────────────────
# Required only when AGENT_LLM_MODEL is a Gemini model AND you are using the
# Gemini API (no service-account credentials).
# Get your key from https://aistudio.google.com/app/apikey
# PowerShell:  $env:GOOGLE_API_KEY = "your_google_api_key_here"
# Bash/macOS:  export GOOGLE_API_KEY="your_google_api_key_here"
GOOGLE_API_KEY=your_google_api_key_here

# ── Google Vertex AI (alternative to Gemini API) ──────────────────────────────
# Use these when you have a GCP service account and want to route Gemini calls
# through Vertex AI instead of the public Gemini API.
#
# GOOGLE_APPLICATION_CREDENTIALS — absolute path to your service-account JSON
#   key file (e.g. /home/user/my-project-abc123.json).
#   When this is set, GOOGLE_API_KEY is ignored for Gemini models.
# VERTEXAI_PROJECT  — GCP project ID that hosts your Vertex AI quota.
# VERTEXAI_LOCATION — region, e.g. us-central1 (defaults to us-central1).
#
# PowerShell example:
#   $env:GOOGLE_APPLICATION_CREDENTIALS = "C:\Users\you\key.json"
#   $env:VERTEXAI_PROJECT = "my-gcp-project"
#   $env:VERTEXAI_LOCATION = "us-central1"
GOOGLE_APPLICATION_CREDENTIALS=
VERTEXAI_PROJECT=
VERTEXAI_LOCATION=us-central1

# ── LLM model selection ───────────────────────────────────────────────────────
# Choose which LLM the agents use.  The factory auto-selects the right provider:
#   • Any name starting with "gemini-"  → Google Gemini or Vertex AI
#       - If GOOGLE_APPLICATION_CREDENTIALS is set → Vertex AI (ChatVertexAI)
#       - Otherwise                               → Gemini API (GOOGLE_API_KEY)
#   • All other names                   → OpenAI       (needs OPENAI_API_KEY)
#
# Supported examples:
#   gemini-2.5-flash-lite     (fast, low cost — recommended, works via Vertex AI or Gemini API)
#   gemini-2.0-flash          (fast, low cost — recommended for quick tests)
#   gemini-1.5-pro
#   gpt-4o-mini               (OpenAI default)
#   gpt-4o
AGENT_LLM_MODEL=gemini-2.5-flash-lite
